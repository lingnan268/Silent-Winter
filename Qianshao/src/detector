#include "detector.h"
#include <algorithm>
#include <cmath>

Detector::Detector(cv::Rect roi) : roi_(roi) {}

std::vector<Bar> Detector::detect(const cv::Mat& frame) {
    std::vector<Bar> bars;
    if (frame.empty()) return bars;
    CV_Assert(frame.type() == CV_8UC3);

    const cv::Rect bounds(0, 0, frame.cols, frame.rows);
    const cv::Rect roi = roi_.empty() ? bounds : (roi_ & bounds);
    if (roi.empty()) return bars;

    // These pixel thresholds were measured on the supplied 668 x 688 clip.
    // Scale lengths by the complete frame, so cropping does not change them.
    const float scale = std::min(frame.cols / 668.0f, frame.rows / 688.0f);
    const float areaScale = scale * scale;

    cv::Mat hsv, lowHue, highHue, mask;
    cv::cvtColor(frame(roi), hsv, cv::COLOR_BGR2HSV);
    cv::inRange(hsv, cv::Scalar(0, 70, 50), cv::Scalar(30, 255, 255), lowHue);
    cv::inRange(hsv, cv::Scalar(155, 70, 50), cv::Scalar(180, 255, 255), highHue);
    cv::bitwise_or(lowHue, highHue, mask);

    // Fill tiny gaps without erasing weak or narrow side-view bars.
    const int kernelSize = std::max(1, 2 * cvRound(scale) + 1);
    cv::morphologyEx(mask, mask, cv::MORPH_CLOSE,
                    cv::getStructuringElement(cv::MORPH_RECT,
                                              cv::Size(kernelSize, kernelSize)));

    std::vector<std::vector<cv::Point>> contours;
    cv::findContours(mask, contours, cv::RETR_EXTERNAL, cv::CHAIN_APPROX_SIMPLE);
    for (const auto& contour : contours) {
        const float area = static_cast<float>(cv::contourArea(contour));
        if (area < 8.0f * areaScale || area > 600.0f * areaScale) continue;

        const cv::RotatedRect rect = cv::minAreaRect(contour);
        const float width = std::min(rect.size.width, rect.size.height);
        const float height = std::max(rect.size.width, rect.size.height);
        if (height < 7.0f * scale || height > 45.0f * scale ||
            width < 1.5f * scale || width > 20.0f * scale ||
            height <= 1.3f * width) continue;

        // Recover the long axis from the actual rectangle edges rather than
        // an angle convention, which differs across OpenCV versions. Its sign
        // is canonical, so top/bottom endpoints cannot swap between frames.
        cv::Point2f corners[4];
        rect.points(corners);
        cv::Point2f axis = corners[1] - corners[0];
        const cv::Point2f other = corners[2] - corners[1];
        if (axis.dot(axis) < other.dot(other)) axis = other;
        const float length = static_cast<float>(cv::norm(axis));
        if (length <= 0.0f) continue;
        if (axis.y < 0.0f || (axis.y == 0.0f && axis.x < 0.0f)) axis *= -1.0f;

        Bar bar;
        bar.center = rect.center + cv::Point2f(static_cast<float>(roi.x),
                                             static_cast<float>(roi.y));
        bar.half = axis * (0.5f * height / length);
        bar.width = width;
        bar.height = height;
        bar.area = area;
        bars.push_back(bar);
    }

    // Deterministic ordering helps repeatable calibration and diagnostics;
    // identities still come from the tracker's measured geometric matches.
    std::sort(bars.begin(), bars.end(), [](const Bar& a, const Bar& b) {
        if (a.center.x != b.center.x) return a.center.x < b.center.x;
        return a.center.y < b.center.y;
    });
    return bars;
}
